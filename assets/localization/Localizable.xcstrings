          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールとパスワードをリンクして、このプレイヤーを変更せずに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 플레이어를 변경하지 않고 이메일과 암호를 연결합니다."
          }
        },
        "nl": {
