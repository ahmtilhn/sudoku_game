    "high_contrast_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Makes the board and text easier to distinguish."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل الكتابة والنص أسهل في التمييز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টেক্সট এবং টেক্সটকে আরও সহজেই বিতর্ক করা যায়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das macht das Schreiben und den Text einfacher zu unterscheiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Facilita la distinción entre el texto y el tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permet de distinguer le tableau et le texte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बोर्ड और पाठ को अलग करना आसान बनाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuat papan dan teks lebih mudah untuk dibedakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Faccia più facile distinguere il testo e il tavolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストとテキストを区別するのが簡単です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테이블과 텍스트를 구별하기 쉽습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het maakt het bord en de tekst gemakkelijker te onderscheiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ułatwia rozróżnienie tablicy i tekstu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz com que o texto e o texto sejam mais fáceis de distinguir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это делает таблицу и текст более простыми для разграничения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทําให้แผ่นและข้อความง่ายต่อการแยกต่างหาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahtayı ve metni ayırt etmeyi kolaylaştırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це робить таблицю і текст простіше розрізняти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ٹیبل اور متن کو آسان طریقے سے الگ کر دیتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm cho bảng và văn bản dễ dàng phân biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使表和文本更容易区分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使表和文字更容易區分。"
          }
        }
      }
    },
