        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma dificuldade e obtenha um novo puzzle"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите трудности и получите новый пuzzle"
