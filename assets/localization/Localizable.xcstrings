    "same_variant_match": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will only be matched with the same game type."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca aynı oyun türünü seçen oyuncularla eşleşirsiniz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف تتوافق فقط مع نفس النوع من اللعبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি শুধু একই খেলা টাইপ সঙ্গে সমাধান হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden nur mit dem gleichen Spielarten vereinbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se ajustará con el mismo tipo de juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne serez pas compatibles avec le même type de jeu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप केवल एक ही खेल के प्रकार के साथ मेल खाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda hanya akan terikat dengan jenis permainan yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarai solo in grado di corrispondere con lo stesso tipo di gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じゲームタイプに合うだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 같은 게임 유형과 일치 할 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wordt alleen geïntroduceerd met dezelfde game."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Będziesz tylko dopasowany do tego samego typu gry."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você só será matched com o mesmo tipo de jogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы будете только совпадать с тем же типом игры."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะตรงกับประเภทเกมเดียวกันเท่านั้น"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви будете тільки збігатися з тим же типом гри."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کو صرف ایک ہی کھیل کے طور پر مطابقت رکھے گا."
