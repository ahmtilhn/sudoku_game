    "delete_player_account_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة المحفظة، والشراء، والصفحة الأصدقاء، والأصدقاء، وتقييم وتاريخ المباراة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফরেক্ট, কেনাকাটা, বন্ধু ID, বন্ধু, রিটিং এবং ম্যাকিং ইতিহাস মুছে ফেলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen Sie Geldwäsche, Einkauf, Freund-ID, Freunde, Rating und Match-Historie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes wallet, purchases, Friend ID, friends, rating and match history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove la cartera, las compras, el ID de amigo, los amigos, la calificación y la historia de la encuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les portefeuilles, les achats, l'ID de l'ami, les amis, la note et l'historique de match."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैबिनेट, खरीदारी, दोस्त आईडी, दोस्त, रेटिंग और मैच इतिहास हटा देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus dompet, pembelian, ID teman, teman, rating dan sejarah pertarungan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove la cassa, gli acquisti, l'ID amico, gli amici, la valutazione e la storia delle match."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "財布、購入、友人ID、友人、評価、および試合歴史を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑, 구매, 친구 ID, 친구, 등급 및 경기 역사 제거."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder portemonnee, aankopen, vriend ID, vrienden, rating en match geschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa portfel, zakupy, ID przyjaciela, przyjaciół, ocenę i historię spotkań."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove carteira, compras, ID de amigo, amigos, classificação e história de encontro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет кошелек, покупки, ID друзей, друзья, рейтинг и историю матча."
          }
        },
        "th": {
          "stringUnit": {
