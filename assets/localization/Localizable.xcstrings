    "career_random_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a difficulty and get a new puzzle"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار صعوبة واحصل على لعبة جديدة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি কঠিনতা নির্বাচন করুন এবং একটি নতুন পুজো পেতে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Schwierigkeit und bekommen Sie ein neues Puzzle"
