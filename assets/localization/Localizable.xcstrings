    "cross_platform_social_service_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku Duelأسماء المستخدمين والأصدقاء والمنافسين الأخيرين والتحديات متصلة من خلال النطاق اليدوي المشترك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku Duelব্যবহারকারীর নাম, বন্ধু, সাম্প্রতিক প্রতিপক্ষ এবং চ্যালেঞ্জ শেয়ারের মাধ্যমে সংযোগিত হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku DuelBenutzernamen, Freunde, jüngste Gegner und Herausforderungen sind über den gemeinsamen Backend verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku Duel usernames, friends, recent opponents, and challenges are connected through the shared backend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku DuelLos nombres de usuario, amigos, oponentes recientes y desafíos se conectan a través del backend compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku DuelLes noms d’utilisateur, les amis, les derniers adversaires et les défis sont reliés à travers le backend partagé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku Duelउपयोगकर्ता नाम, दोस्त, हाल के प्रतिद्वंद्वियों और चुनौतियों को साझा बैकवेन के माध्यम से जोड़ा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku DuelNama pengguna, teman, lawan baru, dan tantangan terhubung melalui backend yang dikongsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku DuelI nomi degli utenti, gli amici, gli avversari recenti e le sfide sono collegati attraverso il backend condiviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku Duelユーザー名、友人、最近の対戦相手、および課題は共有バックエンドを通じて接続されています。"
