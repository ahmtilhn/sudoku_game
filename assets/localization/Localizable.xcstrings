    "samurai_zoom_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch to zoom and drag to move across the five linked boards."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş bağlantılı tahtada gezinmek için yakınlaştırın ve sürükleyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحريك وتسريع للتحرك عبر الألواح الخمسة المرتبطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জুম এবং জুম করতে পিন্ক করুন এবং পাঁচটি সংযুক্ত বোর্ডের মাধ্যমে চলে যাওয়া।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch zum Zoom und ziehen, um über die fünf verbundenen Tische zu bewegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincha para zoomir y traer para moverse a través de los cinco placas conectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez pour zoom et tracer pour se déplacer par les cinq plaques liées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ूम करने के लिए पंच करें और पांच लिंक बोर्डों के माध्यम से आगे बढ़ने के लिए खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin untuk zoom dan drag untuk bergerak melalui lima papan terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch per zoom e tirare per muoversi attraverso i cinque tavoli collegati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチを振り回し、5つの接続されたボードを移動するために引き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스핀을 눌러 주름을 끌고 5 개의 연결된 보드를 통해 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch naar zoom en trek om te bewegen over de vijf verbonden plafonds."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz do zoomu i wyciągnij, aby przejść przez pięć powiązanych płytek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinque para zoom e treze para se mover através dos cinco painéis ligados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите к зуму и вытягивайте, чтобы перемещаться через пять связанных панелей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch เพื่อ zoom และ drag เพื่อย้ายผ่านห้าแผงเชื่อมต่อ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть на зум і витягніть, щоб пересуватися через п'ять пов'язаних панелей."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پینچ کریں اور زوم اور ٹریک کریں پانچ منسلک بورڈوں کے ذریعے منتقل کرنے کے لئے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin đến zoom và kéo để di chuyển qua năm bảng kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 zoom 并拖动,通过五个连接板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選 zoom 並拖動,透過五個連線板。"
          }
        }
      }
    },
    "samurai_pause_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your five linked boards are paused. Continue when ready."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş bağlantılı tahta duraklatıldı. Hazır olduğunuzda devam edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "5 ألواح متصلة متوقفة.مواصلة عند الاستعداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পাঁচটি লিংক বোর্ড বন্ধ হয়ে থাকে. প্রস্তুত হলে চলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre fünf verbundenen Plätze werden aufgehoben.Fortsetzung, wenn Sie bereit sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cinco placas conectadas están descansadas. Continúa cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos 5 boîtes liées sont en pause. Continuez quand vous êtes prêt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पांच लिंक बोर्ड रुक गए हैं. जब तैयार हो तो जारी रखें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lima paket yang sudah terhubung di sini sudah selesai.Selengkapnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi cinque tavoli collegati sono interrotti. proseguire quando pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5 つながった板が休憩しているので、準備が整ったときに続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5개의 링크가 멈추고 준비가 되면 계속 진행하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vijf verbonden bords zijn gespaard. voortgaan als je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pięć powiązanych płytek jest przerwane. kontynuuj, gdy gotowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus cinco painéis ligados estão interrompidos. Continue quando pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять связанных панелей перерываются.Подробнее, когда вы готовы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "5 แผงที่เชื่อมต่อของคุณหยุดทํางานได้ ทํางานเมื่อพร้อม"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "П'ять з них перерваються, і продовжуйте, коли ви готові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے پانچ منسلک بورڈوں کو روک دیا گیا ہے ۔ جب تیار ہو تو جاری رہیں ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "5 bàn liên kết của bạn bị gián đoạn. tiếp tục khi sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五个连接板停了下来,当准备好时继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五個連線板停了下來,當準備好時繼續。"
          }
        }
      }
    },
