    "mistake_limit_reached": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You made %1d wrong moves. Choose how you want to continue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت جعلت%1dالخطأ في التحرك: اختر كيف تريد المضي قدماً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি তৈরি করেছেন%1dভুল গতি, আপনি কীভাবে চলতে চান তা নির্বাচন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gemacht%1dFehlerbewegungen. wählen Sie, wie Sie weitergehen möchten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y tú haces%1dLos movimientos equivocados. escoge cómo quieres seguir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez fait%1dFaites des choix, choisissez comment vous voulez continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने बनाया%1dगलत कदम उठाएं. चुनें कि आप कैसे आगे बढ़ना चाहते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membuat%1dLangkah yang salah. pilih cara yang ingin Anda lanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu hai fatto%1dIl movimento sbagliato: scegli come vuoi continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが作った%1d間違った動きを選択し、どのように進むかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 만들었다%1d잘못된 움직임을 선택하십시오.당신이 계속하고자하는 방법을 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij hebt gemaakt%1dverkeerde bewegingen. kies hoe je wilt voortzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty zrobiłeś%1dWybierz sposób, w jaki chcesz kontynuować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você fez%1dMudanças erradas. escolha como você quer continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы сделали%1dНеправильные движения.Выберите, как вы хотите продолжить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณทํา%1dการเคลื่อนไหวที่ผิด เลือกวิธีที่คุณต้องการที่จะดําเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen yaptın.%1dyanlış hamleler. Nasıl devam etmek istediğinizi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви зробили%1dВибирайте, як ви хочете продовжувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نے کیا%1dغلط حرکتیں ۔ انتخاب کریں کہ آپ کس طرح جاری رکھنا چاہتے ہیں ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã làm%1dLời bài hát: Choose How You Want to Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你做%1d错误的动作,选择你想要继续的方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你做%1d錯誤的動作,選擇你想要繼續的方式。"
          }
        }
      }
    },
