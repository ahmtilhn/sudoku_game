    "guest_account_risk": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف التطبيق أو تغيير الأجهزة يمكن أن تجعل هذا الضيف غير متاح.Coinس س"
