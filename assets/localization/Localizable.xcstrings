    "matchmaking_start_failed": {
      "comment": "Online duel UI text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to start opponent search. Please try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن البدء في البحث مع المعارضين، يرجى المحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি প্রতিপক্ষের অনুসন্ধান শুরু করতে পারেন না. कृपया আবার চেষ্টা করুন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können nicht die Suche des Gegners starten. versuchen Sie bitte erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede iniciar la búsqueda de oponente. por favor, intente de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas commencer la recherche de l'opposant. veuillez essayer à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विरोधी खोज शुरू करने में असमर्थ है. कृपया फिर से कोशिश करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa memulai pencarian lawan. silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile avviare la ricerca di un avversario. si prega di provare di nuovo."
