    "online_forfeit_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving an active online duel forfeits the match to your opponent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif bir online düellodan ayrılmak maçı rakibine kazandırır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein aktives Online-Duell verlässt, gewinnt dein Gegner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter un duel en ligne actif donne la victoire à votre adversaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de un duelo en línea activo da la victoria a tu rival."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair de um duelo online ativo dá a vitória ao oponente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscire da un duello online attivo assegna la vittoria all’avversario."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een actief online duel verlaat, wint je tegenstander."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opuszczenie aktywnego pojedynku online daje zwycięstwo przeciwnikowi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход из активной онлайн-дуэли отдаст победу сопернику."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихід з активної онлайн-дуелі віддасть перемогу супернику."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مغادرة نزال نشط عبر الإنترنت تمنح الفوز لخصمك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय ऑनलाइन मुकाबला छोड़ने पर जीत प्रतिद्वंद्वी को मिलेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dari duel online aktif memberikan kemenangan kepada lawan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中のオンライン対戦を離れると相手の勝利になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중인 온라인 대전을 나가면 상대가 승리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开进行中的在线对局会让对手获胜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開進行中的線上對局會讓對手獲勝。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การออกจากดวลออนไลน์ที่กำลังเล่นอยู่จะให้คู่แข่งชนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rời trận đấu trực tuyến đang diễn ra sẽ trao chiến thắng cho đối thủ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলমান অনলাইন ডুয়েল ছাড়লে প্রতিপক্ষ জিতে যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال آن لائن مقابلہ چھوڑنے سے حریف جیت جائے گا۔"
          }
        }
      }
    },
