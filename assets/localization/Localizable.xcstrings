    "ad_privacy_choices_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review or change the privacy choices used for advertising."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة أو تغيير خيارات الخصوصية المستخدمة في الإعلانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিজ্ঞাপন জন্য ব্যবহার করা ব্যক্তিগততা নির্বাচনগুলি দেখুন বা পরিবর্তন করুন।"
