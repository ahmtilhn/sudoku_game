    "discoverable_by_players_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow username, display-name and exact Friend ID search. Existing friends remain connected when disabled."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم، اسم العرض، والبحث الدقيق عن ID صديق.الصديقين الحاليين يبقى متصل عند إلغاء التشغيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যবহারকারীর নাম, প্রদর্শন নাম এবং সঠিক বন্ধু ID অনুসন্ধান অনুমতি দেয়. অস্তিত্বিক বন্ধুগুলি অ্যাক্সেস হলে সংযোগিত থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie Benutzernamen, Display-Namen und genaue Suche nach Freund-ID. bestehende Freunde bleiben bei der Unaktivierung verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el nombre de usuario, el nombre de pantalla y la búsqueda exacta de la ID de amigo. Los amigos existentes permanecen conectados cuando se deshabilite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettez le nom d'utilisateur, le nom d'affichage et la recherche exacte de l'ID de l'ami. Les amis existants restent connectés lorsque l'utilisateur est désactivé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोगकर्ता नाम, प्रदर्शित नाम और सटीक मित्र आईडी खोज की अनुमति दें. मौजूदा दोस्त अक्षम होने पर कनेक्ट रहते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan nama pengguna, nama tampilan dan pencarian ID Friend yang tepat. teman yang ada tetap terhubung ketika terganggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettere di trovare il nome utente, il nome di visualizzazione e la ricerca esatta di Friend ID. Gli amici esistenti rimangono connessi quando sono disabilitati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名、表示名、正確な友人のID検索を許可します. 無効になった場合、既存の友人が接続されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 이름, 표시 이름 및 정확한 친구 ID 검색을 허용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat gebruikersnaam, display-name en exacte Friend ID zoeken. bestaande vrienden blijven verbonden wanneer ze worden uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól na wyszukiwanie nazwy użytkownika, nazwy wyświetlacza i dokładnego identyfikatoru znajomych. istniejący znajomi pozostają podłączeni po wyłączeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir o nome de usuário, o nome de exibição e a busca exata de ID de amigo. Os amigos existentes permanecem conectados quando desativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте имя пользователя, имя отображения и точный поиск ID Друзей. существующие друзья остаются подключены, когда они отключены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ชื่อผู้ใช้ชื่อแสดงและค้นหา ID เพื่อนที่ถูกต้อง เพื่อนที่มีอยู่จะยังคงเชื่อมต่อเมื่อปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adı, display-name ve tam Friend ID aramasına izin verin. Mevcut arkadaşlar devre dışı bırakıldığında bağlı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте знайти ім'я користувача, ім'я відображення та точне пошук ідентифікатора друзів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صارف کا نام، دکھائیں نام اور صحیح دوست ID تلاش کریں۔ موجودہ دوستوں کو غیر فعال ہونے پر منسلک رہنا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép tên người dùng, tên hiển thị và tìm kiếm chính xác ID bạn bè. bạn bè hiện có vẫn được kết nối khi bị tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许用户名、显示名称和准确的友人 ID 搜索. 已有朋友在关闭时保持连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許使用者名稱、顯示名稱和準確的友人 ID 搜尋. 已有朋友在關閉時保持連線。"
          }
        }
      }
    },
