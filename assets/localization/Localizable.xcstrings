    "matchmaking_unexpected_response": {
      "comment": "Online duel UI text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The matchmaking server returned an unexpected response."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاد خادم التوافق رد فعل غير متوقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভারটি একটি অপ্রত্যাশিত উত্তর ফিরে দিয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Matchmaking-Server gab eine unerwartete Antwort zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de la matriculación devolvió una respuesta inesperada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de matchmaking a reçu une réponse inattendue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैटमिंग सर्वर ने एक अप्रत्याशित प्रतिक्रिया वापस दी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server matchmaking mengembalikan respons yang tidak dijangka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server di matchmaking ha restituito una risposta inaspettata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マッチメイクサーバーは予期せぬ反応を返しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 서버는 예기치 않은 응답을 반환했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De matchmaking server heeft een onverwachte reactie teruggegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer zbioru zwrócił nieoczekiwaną odpowiedź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de matchmaking devolveu uma resposta inesperada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер по удалению возвращал неожиданную реакцию."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์การจัดหาการแข่งขันได้ส่งคืนการตอบสนองที่ไม่คาดหวัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöpçatanlık sunucusu beklenmedik bir yanıt verdi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер повернув несподіваний відповідь."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مٹنگ سرور نے ایک غیر متوقع جواب واپس دیا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ matchmaking trả lại một phản ứng bất ngờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相匹配服务器回来了意想不到的回应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相匹配伺服器回來了意想不到的回應。"
          }
