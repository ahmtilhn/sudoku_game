    "service_diagnostics_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the installed build, Firebase session and social server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من البناء المثبت، جلسة Firebase والخادم الاجتماعي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনস্টল করা build, Firebase সেশন এবং সামাজিক সার্ভার দেখুন।"
          }
        },
        "de": {
          "stringUnit": {
