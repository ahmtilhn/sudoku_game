    "account_protection_banner_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link an email before buying Coins so your wallet, Friend ID and rating can be recovered after reinstall or device change."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال رسالة إلكترونية قبل الشراءCoinلذلك يمكن استرداد محفظتك و ID صديقك و تصنيفك بعد إعادة تثبيت أو تغيير الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেনার আগে একটি ইমেইল লিঙ্ক করুনCoinতাই আপনার ফরেক্ট, বন্ধু ID এবং রিটারেট পুনরায় ইনস্টল করার পর বা ডিভাইস পরিবর্তনের পরে পুনরায় ফিরে আসতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Link eine E-Mail vor dem KaufCoinSo können Ihr Portfolio, Freund-ID und Rating nach der Wiederinstallation oder Gerätwechsel wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlazar un correo electrónico antes de comprarCoinAsí que su bolsillo, ID de amigo y calificación se pueden recuperar después de reinstalar o cambiar el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lien vers un email avant d’acheterCoinVotre portefeuille, votre ID de ami et votre notation peuvent être récupérées après réinstallation ou changement de périphérique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीदने से पहले एक ईमेल लिंक करेंCoinइसलिए आपका बटुआ, मित्र आईडी और रेटिंग पुन: स्थापित करने या डिवाइस परिवर्तन के बाद पुनर्प्राप्त किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Link email sebelum membeliCoinDengan demikian dompet, ID Friend dan rating Anda dapat dikembalikan setelah pemasangan ulang atau perubahan perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Link di un email prima di acquistareCoinIl tuo portafoglio, il tuo ID di amico e la tua valutazione possono essere recuperati dopo la ristrutturazione o la modifica del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入前にメールをリンクするCoinだから、財布、友人ID、評価は再インストールまたはデバイス変更後に回復することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매하기 전에 이메일을 링크Coin그래서 귀하의 지갑, 친구 ID 및 등급은 재설치 또는 장치 변경 후 복구 될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link een e-mail voordat je kooptCoins dus uw portemonnee, vriend ID en rating kunnen worden hersteld na herinstallatie of apparaat verandering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie e-maila przed zakupemCoinTwój portfel, ID przyjaciela i rating można odzyskać po ponownej instalacji lub zmianie urządzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Link um e-mail antes de comprarCoinAssim, seu bolso, ID de amigo e notação podem ser recuperados após a reinstalação ou alteração do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, свяжитесь с электронной почтой перед покупкойCoinТак что ваш кошелек, ID и рейтинг друзей могут быть восстановлены после перезагрузки или изменения устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงค์อีเมลก่อนซื้อCoins ดังนั้นเงินสดของคุณ ID เพื่อนและคะแนนสามารถรับคืนได้หลังจากติดตั้งใหม่หรือเปลี่ยนอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın almadan önce bir e-posta bağlayınCoinBöylece cüzdanınız, Arkadaş Kimliğiniz ve derecelendirmeniz yeniden yüklendikten veya cihaz değişikliğinden sonra kurtarılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання на електронну пошту перед покупкоюCoinТак, ваш кошелек, ідентифікатор друзів і рейтинг можна відновити після перезавантаження або зміни пристрою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خریدنے سے پہلے ایک ای میل لنک کریںCoinاس طرح آپ کے پیسہ، دوست ID اور درجہ بندی دوبارہ انسٹال یا آلہ تبدیل کرنے کے بعد واپس حاصل کیا جا سکتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết email trước khi muaCoins để ví, ID bạn bè và đánh giá của bạn có thể được khôi phục sau khi cài đặt lại hoặc thay đổi thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "購買前連結電子郵件Coin因此,您的钱包、朋友身份证和评级可以在重新安装或设备更改后恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買前連結電子郵件Coin因此,您的錢包、朋友身份證和評級可以在重新安裝或裝置更改後恢復。"
          }
        }
      }
    },
