    "rewarded_ad_prototype_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rewarded ad provider will be connected in the monetization phase. Continue now to test the recovery flow."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم توصيل المورد المكافأة في مرحلة التمويل.مواصلة الآن لاختبار تدفق الانتعاش."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরস্কার প্রদানকারী বিজ্ঞাপন প্রদানকারী মুদ্রিত ফ্যাশনে সংযোগিত হবে. এখন ফিরে আসার প্রদর্শন পরীক্ষা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der belohnte Anzeigeleiter wird in der Monetierungsphase verbunden sein. Weiter jetzt, um den Erholungsfluss zu testen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor de anuncios premiado se conectará en la fase de monetización. Continuar ahora para probar el flujo de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur d'annonces récompensé sera connecté dans la phase de monétisation. Continuez maintenant pour tester le flux de récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरस्कार प्राप्त विज्ञापन प्रदाता को मुद्राकरण चरण में कनेक्ट किया जाएगा. अब पुनर्प्राप्ति प्रवाह का परीक्षण करने के लिए जारी रखें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembekal iklan yang dianugerahkan akan terhubung dalam fasa monetisasi. lanjutkan sekarang untuk menguji aliran pemulihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore di annunci premiati sarà collegato nella fase di monetizzazione. Continua ora per testare il flusso di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報酬を受けた広告プロバイダーは、通貨化段階で接続されます。今すぐ回復流をテストし続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보상된 광고 제공자는 통화 단계에서 연결될 것입니다.이제 회복 흐름을 테스트하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De belonende advertentieprovider zal in de monetiseringsperiode verbonden zijn.Vervolg nu om de herstelstromen te testen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrodzony dostawca reklam będzie podłączony w fazie monetizacji. kontynuuj teraz, aby przetestować przepływ odzyskiwania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fornecedor de anúncios recompensado estará conectado na fase de monetização. Continue agora para testar o fluxo de recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Награжденный рекламодатель будет подключен в монетаризации.Настаньте сейчас, чтобы тестировать поток выздоровления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ให้บริการโฆษณาที่ได้รับรางวัลจะเชื่อมต่อในขั้นตอนการเงินสด ต่อตอนนี้เพื่อทดสอบการไหลเวียนการกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödüllendirilen reklam sağlayıcısı para kazanma aşamasında bağlanacaktır. Kurtarma akışını test etmek için şimdi devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагородова рекламодавця буде підключена в етап монетізації. продовжуйте тепер, щоб перевірити потік відновлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انعام کردہ اشتہارات فراہم کرنے والے کو منافع بخش مرحلے میں منسلک کیا جائے گا. اب دوبارہ ٹیسٹ کرنے کے لئے جاری رکھیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp quảng cáo được thưởng sẽ được kết nối trong giai đoạn tiền tệ. tiếp tục thử nghiệm dòng hồi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获奖的广告提供商将在货币化阶段连接,现在继续测试恢复流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獲獎的廣告提供商將在貨幣化階段連線,現在繼續測試恢復流。"
          }
        }
      }
    },
    "time_up_turn_passed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time is up. The turn passed to the other player."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت الانتقال: انتقلت الدور إلى اللاعب الآخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় এসেছে, ফেরতের পথ অন্য খেলোয়াড়কে দিয়েছে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit ist auf. Die Runde wurde an den anderen Spieler übertragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo se ha ido.El turno se ha pasado al otro jugador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps est arrivé, le tour est passé à l'autre joueur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय आ गया है. दौर दूसरे खिलाड़ी को पारित किया गया है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu sudah tiba. putaran itu dipindahkan ke pemain lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo è in arrivo: il turno è passato all'altro giocatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間は上昇し、回転は他のプレイヤーに移った。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간은 올라가고, 회전은 다른 플레이어에게 전달되었다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijd is op. De omloop is overgegaan naar de andere speler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas się skończył, a turniej przeszedł do drugiego gracza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo chegou. a volta passou para o outro jogador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время наступило. поворот перешел к другому игроку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาขึ้น การหมุนผ่านไปกับผู้เล่นอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaman doldu, sıra diğer oyuncuya geçti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час закінчився, і повернення перейшло до іншого гравця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت آ گیا ۔ ٹور دوسرے کھلاڑی کو منتقل کر دیا گیا ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian đã đến. vòng quay đã chuyển sang người chơi khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间已经到来,转转向另一名球员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間已經到來,轉轉向另一名球員。"
          }
        }
      }
    },
