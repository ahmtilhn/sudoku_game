        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochrona konta przed zakupem"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja sua conta antes de comprar"
          }
        },
        "ru": {
