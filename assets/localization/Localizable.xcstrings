            "value": "Link e-mail en wachtwoord zonder deze speler te veranderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie e-mail i hasła bez zmiany tego gracza."
          }
        },
        "pt": {
