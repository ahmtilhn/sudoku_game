        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hộp khôn cũng phải chứa mỗi số một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个勇敢的盒子也必须包含每个数字一次。"
