    "sign_in_switches_guest": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل في التبديلات بعيدا عن هذا الضيف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই গেস্ট থেকে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে বাইরে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterzeichnen Sie sich in Schwankungen von diesem Gast entfernt. Wallets sind nicht miteinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in switches away from this guest. Wallets are not merged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue en los switches lejos de este invitado. las bolsas no se fusionan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signature dans des switches loin de cet hôte. Les portefeuilles ne sont pas fusionnées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मेहमान से दूर स्विच में हस्ताक्षर करें. बैग नहीं मिलाए जाते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandatangani pertukaran jauh dari tamu ini. dompet tidak digabungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iscriversi in scambi lontano da questo ospite. i portafogli non sono messi in contatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストから離れたスイッチにサインする 財布は合わない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 손님에서 멀리 스위치에 서명.이 지갑은 합병되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in switches weg van deze gast. wallets zijn niet samengesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpisanie w przelewach z dala od tego gościa. portfel nie jest połączony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinando em switches longe deste hóspede. bolsas não são misturadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписывайтесь на переключаниях от этого гостя. сумки не сливаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงทะเบียนในสวิตช์ห่างจากผู้เข้าพักนี้ กระเป๋าถือไม่ได้รวม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konuktan uzaklaşan anahtarlar imzalanıyor. Cüzdanlar birleştirilmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписувати в перемикачах далеко від цього гостя."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس مہمان سے دور سوئچ میں دستخط کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký trong các chuyển đổi xa khách này. túi không được kết hợp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅此客人远离交换机,钱包不合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱此客人遠離交換機,錢包不合並。"
          }
        }
      }
    },
