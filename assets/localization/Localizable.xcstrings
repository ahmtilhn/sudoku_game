    "welcome_returning_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue your career or challenge another player."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر في مسيرتك أو تحدي لاعب آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ক্যারিয়ার চালু করুন বা অন্য খেলোয়াড়কে চ্যালেঞ্জ করুন।"
          }
        },
        "de": {
