    "daily_sudoku_challenges_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three optional reminders each day at 09:00, 15:00, and 20:30. You can turn them off at any time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثة تذكير اختياري كل يوم في الساعة 09:00 و 15:00 و 20:30."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন 09:00, 15:00, এবং 20:30 এ তিনটি অপশনীয় স্মৃতিশক্তি আপনাকে যে কোন সময় বন্ধ করতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei optionale Erinnerungen jeden Tag um 09:00, 15:00 und 20:30. Sie können sie jederzeit deaktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres recuerdos opcionales cada día a las 09:00, 15:00 y 20:30."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois rappels facultatifs chaque jour à 9h, 15h et 20h30 Vous pouvez les désactiver à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन 9 बजे, 15 बजे और 20:30 बजे तीन वैकल्पिक यादें बंद हो सकती हैं. आप उन्हें किसी भी समय बंद कर सकते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga kenangan pilihan setiap hari pada pukul 09:00, 15:00, dan 20:30. Anda dapat mematikan mereka kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre ricordi opzionali ogni giorno alle 09:00, 15:00 e 20:30."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日9時、15時、20時30分に3つのオプションの思い出が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 오전 9시, 오후 5시, 오후 8시 30분에 3개의 선택적 추억이 켜져 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie optionele herinneringen elke dag om 09:00, 15:00 en 20:30. u kunt ze op elk moment uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy opcjonalne przypomnienia każdego dnia o godz. 09:00, 15:00 i 20:30. można je odłączyć w dowolnym momencie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Três lembranças opcionais todos os dias às 09:00, 15:00 e 20:30."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три варианта напоминаний каждый день в 09:00, 15:00 и 20:30. Вы можете отключить их в любое время."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามคําเตือนแบบเลือกทุกวันใน 09:00, 15:00 และ 20:30 คุณสามารถเปิดพวกเขาได้ตลอดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün saat 09:00, 15:00 ve 20:30'da üç isteğe bağlı hatırlatıcı. İstediğiniz zaman kapatabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Три факультативні спогади щодня о 09:00, 15:00 і 20:30. Ви можете відключити їх в будь-який час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر روز 9 بجے، 15 بجے اور 20 بجے تین اختیاری یادداشتیں.آپ ان کو کسی بھی وقت بند کر سکتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba ký ức tùy chọn mỗi ngày lúc 09:00, 15:00 và 20:30. bạn có thể tắt chúng bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天9点,15点,20点30分,有三次可选提醒,随时可关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天9點,15點,20點30分,有三次可選提醒,隨時可關閉。"
          }
        }
      }
    },
    "daily_reminder_permission_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was not granted. Daily reminders remain off."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم منح إذن الإشعار.تظل التذكرات اليومية غير مألوفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সারাদিন বার্তা বন্ধ থাকবে না, সারাদিন বার্তা বন্ধ থাকবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifizierungsverleih wurde nicht erteilt. tägliche Erinnerungen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido permiso de notificación. los recuerdos diarios permanecen apagados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications ne sont pas autorisées. les rappels quotidiens sont hors."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना अनुमति नहीं दी गई. दैनिक यादें बंद रहती हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada izin pemberitahuan yang diberikan. peringatan harian tetap dihentikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato dato il permesso di notifica. i ricordi giornalieri rimangono fuori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知許可は与えられていません. 毎日のメモは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통지 허가가 부여되지 않았습니다.일상 추억은 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificatievergunning is niet verleend. dagelijkse herinneringen blijven af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma zgody na powiadomienie. codzienne przypomnienia pozostają znikające."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi concedida a permissão de notificação. lembranças diárias permanecem apagadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помните, что не было разрешения на уведомление.Вседневные напоминания остаются закрытыми."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนไม่ได้รับอนุญาต การแจ้งเตือนประจําวันยังคงปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni verilmedi. Günlük hatırlatmalar kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення не було видано. щоденні спогади залишаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹس کی اجازت نہیں دی گئی ۔ روزانہ یادداشتیں بند رہیں گی ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không được cấp phép thông báo. những lời nhắc hàng ngày vẫn còn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知许可未授予,日记留下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知許可未授予,日記留下。"
          }
        }
      }
    },
