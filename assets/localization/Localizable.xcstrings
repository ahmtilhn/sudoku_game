    "delete_player_account_warning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إلغاء ذلك.سيتم إزالة المحفظة والمشتريات والأصدقاء وتاريخ التصنيف والمباراة.تنتهي المباريات النشطة على الإنترنت أولا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি অস্বীকার করা যাবে না. পয়েন্ট, কেনাকাটা, বন্ধু, রিটিং এবং ম্যাচ ইতিহাস মুছে ফেলবে. প্রথমেই সক্রিয় অনলাইন ম্যাচ শেষ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann nicht vermieden werden. Wallet, Einkauf, Freunde, Rating und Match-Historie werden entfernt. Beendete aktives Online-Spiel zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. Wallet, purchases, friends, rating and match history will be removed. Finish active online matches first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no puede ser indebido.Las bolsas, las compras, los amigos, la calificación y la historia de los partidos se eliminarán.Finalizar los partidos en línea activos primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci ne peut pas être évité. portefeuille, achats, amis, notations et histoire de match seront supprimés. Finissez les matchs en ligne actifs d'abord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अपरिहार्य नहीं हो सकता. बटुए, खरीदारी, दोस्त, रेटिंग और मैच इतिहास हटा दिया जाएगा. पहले सक्रिय ऑनलाइन मैचों को समाप्त करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tidak bisa dihindari. dompet, pembelian, teman, rating dan sejarah pertandingan akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portfolio, gli acquisti, gli amici, la valutazione e la storia delle partite saranno rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "財布、買い物、友人、評価、試合の歴史が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이건 무시할 수 없습니다. 지갑, 구매, 친구, 등급 및 경기 역사 삭제됩니다. 먼저 활성 온라인 경기를 마무리합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ontbreken. wallet, aankopen, vrienden, rating en matchgeschiedenis zullen worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieniądze, zakupy, przyjaciele, rating i historia meczu zostaną usunięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dinheiro, compras, amigos, classificação e história do jogo serão removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не может быть без. Портфель, покупки, друзья, рейтинг и история матча будут удалены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่ไม่สามารถหลีกเลี่ยงได้ เงินสด, การซื้อ, เพื่อน, การคะแนนและประวัติการแข่งขันจะถูกลบ เสร็จสิ้นการแข่งขันออนไลน์ที่ใช้งานได้ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geri alınamaz. Cüzdan, satın alımlar, arkadaşlar, derecelendirme ve maç geçmişi kaldırılacaktır. Önce aktif çevrimiçi maçları bitirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не може бути без. портфелі, покупки, друзі, рейтинги та історія матчів будуть видалені."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ نہیں ہو سکتا. پیسہ، خریداری، دوستوں، درجہ بندی اور میچ کی تاریخ ہٹا دیا جائے گا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiền mặt, mua sắm, bạn bè, đánh giá và lịch sử trận đấu sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包、购物、朋友、评分和比赛历史将被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錢包、購物、朋友、評分和比賽歷史將被刪除。"
          }
        }
      }
    },
