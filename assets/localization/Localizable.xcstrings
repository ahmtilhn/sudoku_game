    "rule_rows_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each number can appear only once in every row."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يظهر كل رقم مرة واحدة فقط في كل صف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি সংখ্যা প্রতিটি পর্যায়ে একবারই প্রদর্শিত হতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zahl kann nur einmal in jeder Reihe angezeigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada número puede aparecer sólo una vez en cada línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque numéro ne peut apparaître qu'une fois dans chaque ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक संख्या में केवल एक बार दिखाई दे सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap angka hanya bisa muncul sekali dalam setiap urutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni numero può apparire solo una volta in ogni riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各数字は、それぞれの順番に一度しか表示されない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 숫자는 각 라인에 한 번만 나타날 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke getal kan slechts één keer in elke rij verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde numer może pojawić się tylko raz w każdej kolejce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada número pode aparecer apenas uma vez em cada linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый номер может появляться только один раз в каждом ряде."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเลขแต่ละตัวสามารถปรากฏขึ้นเพียงครั้งเดียวในแต่ละแถว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sayı her satırda sadece bir kez görünebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне число може з'являтися лише один раз у кожній рядку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر نمبر صرف ایک بار ہر سیریز میں ظاہر ہوسکتا ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi số chỉ có thể xuất hiện một lần trong mỗi hàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个数字只能在每个行中出现一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個數字只能在每個行中出現一次。"
          }
        }
      }
    },
