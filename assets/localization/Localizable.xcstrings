            "state": "translated",
            "value": "Revisa o cambia las opciones de privacidad utilizadas para la publicidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réviser ou modifier les choix de confidentialité utilisés pour la publicité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज्ञापन के लिए उपयोग किए जाने वाले गोपनीयता विकल्पों की समीक्षा या परिवर्तन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertimbangkan atau ubah pilihan privasi yang digunakan untuk iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispettare o modificare le scelte di privacy utilizzate per la pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告に使用されるプライバシーの選択肢を検討または変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고에 사용되는 개인 정보 보호 선택을 검토하거나 변경합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk of wijzigen de privacy-opties die worden gebruikt voor reclame."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegląd lub zmiana opcji prywatności stosowanych w reklamie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise ou altera as opções de privacidade usadas para a publicidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обзор или изменение вариантов конфиденциальности, используемых для рекламы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีวิวหรือเปลี่ยนตัวเลือกความเป็นส่วนตัวที่ใช้สําหรับการโฆษณา"
