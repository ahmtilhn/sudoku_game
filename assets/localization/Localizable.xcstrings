    "rule_columns_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same number cannot appear twice in a column."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تظهر نفس الرقم مرتين في عمود واحد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই সংখ্যা একটি তুলনায় দুবার দেখা যায় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gleiche Zahl kann nicht zweimal in einer Spalte angezeigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo número no puede aparecer dos veces en una columna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même nombre ne peut pas apparaître deux fois dans une colonne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही संख्या को एक स्तंभ में दो बार नहीं दिखाई देती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka yang sama tidak dapat muncul dua kali dalam satu kolom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero non può essere visualizzato due volte in una colonna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ数字は、コラムに2回表示できない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 숫자는 열에 두 번 나타나지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hetzelfde getal kan niet twee keer in een kolom verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można w jednym kolumnie wyświetlać tej samej liczby dwa razy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo número não pode aparecer duas vezes em uma coluna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То же число не может появиться дважды в колоне."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเลขเดียวกันไม่สามารถปรากฏสองครั้งในคอลัมน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı sayı bir sütunda iki kez görünemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таке ж число не може з'явитися двічі в колоні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک ہی اعداد و شمار ایک ستون میں دو بار نہیں دکھائی دیتا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tương tự không thể xuất hiện hai lần trong một cột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一数字不能在一个列中出现两次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一數字不能在一個列中出現兩次。"
          }
        }
      }
    },
