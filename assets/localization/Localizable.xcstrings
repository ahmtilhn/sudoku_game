    "rule_boxes_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bold box must also contain every number once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يحتوي كل صندوق شجاع أيضًا على كل رقم مرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ক্যাশটি একবারই প্রতিটি সংখ্যা রাখতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Schwerenbox muss auch jede Nummer einmal enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada cuadro de valor debe contener cada número una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque boîte courageuse doit également contenir chaque numéro une fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक बहादुर बॉक्स में एक बार में प्रत्येक संख्या भी शामिल होनी चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kotak berani juga harus mencakup setiap nomor sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni casella deve contenere ogni numero una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボックスには、それぞれの数字が1回含まれる必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 용감한 상자는 또한 각 숫자를 한 번 포함해야합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke boot moet ook elke nummer één keer bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda pudełko musi zawierać każdą liczbę raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada caixa corajosa deve também conter cada número uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый смелый ящик должен также содержать каждый номер один раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล่องแต่ละกล่องจะต้องมีหมายเลขแต่ละครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her cesur kutu aynı zamanda her sayıyı bir kez içermelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна коробка повинна також містити кожну цифру один раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
