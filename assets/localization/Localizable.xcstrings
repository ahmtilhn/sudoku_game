            "state": "translated",
            "value": "احرص على حماية حسابك قبل الشراء"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেনার আগে আপনার অ্যাকাউন্ট সুরক্ষা করুন"
