            "value": "Начните свою карьеру или вызовите другого игрока."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิบัติการอาชีพหรือท้าทายผู้เล่นอื่น ๆ"
