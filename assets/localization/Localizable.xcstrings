    "pending_challenges_empty_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الدعوات الجديدة هنا ويمكن الوصول إليها أيضًا عن طريق الضغط على الإشعار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন আমন্ত্রণ এখানে প্রদর্শিত হবে এবং আপনাকে বিজ্ঞাপন অনুসরণের মাধ্যমেও পৌঁছাতে পারে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Einladungen werden hier angezeigt und können auch durch Druckmeldung angekommen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New invitations will appear here and can also arrive by push notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevas invitaciones aparecerán aquí y también pueden llegar mediante la notificación de pulsación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nouvelles invitations apparaîtront ici et peuvent également arriver par pression de notification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए निमंत्रण यहां दिखाई देंगे और सूचना दबाकर भी पहुंच सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panggilan baru akan muncul di sini dan juga dapat datang dengan pemberitahuan push."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuove inviti saranno visualizzati qui e possono arrivare anche tramite la notifica di push."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい招待状がここに表示され、通知を押すことによって到着することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 초대장이 여기에서 나타나고 또한 눌러 통지로 도착할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe uitnodigingen verschijnen hier en kunnen ook komen door een push-notifice."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe zaproszenia pojawią się tutaj i mogą również przyjść poprzez push powiadomienie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas convites aparecerão aqui e também podem chegar por notificação de pressão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые приглашения будут появляться здесь и могут прийти также путем подачи уведомления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนใหม่จะปรากฏที่นี่และสามารถเข้าถึงได้โดยการแจ้งเตือนกด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni davetler burada görünecek ve push bildirimi ile de gelebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові запрошення з'являться тут і можуть також прийти за допомогою повідомлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئے دعوتیں یہاں ظاہر ہوں گی اور بھی نوٹس پر کلک کرکے پہنچ سکتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lời mời mới sẽ xuất hiện ở đây và cũng có thể đến bằng cách nhấn thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新邀请将出现在这里,也可以通过按下通知来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新邀請將出現在這裡,也可以透過按下通知來。"
          }
        }
      }
    },
