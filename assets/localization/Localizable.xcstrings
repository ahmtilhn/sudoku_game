    "clear_progress_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed career levels and records will be removed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إزالة مستويات المهنة والرسوم البيانية المكتملة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পূর্ণ ক্যারিয়ার স্তর এবং রেকর্ড মুছে ফেলবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendete Karrieregraden und Aufzeichnungen werden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los niveles de carrera y los registros completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les niveaux de carrière et les records seront supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा कैरियर स्तर और रिकॉर्ड हटा दिया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingkat karir dan rekaman yang selesai akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I livelli e i record di carriera completati saranno rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成したキャリアレベルと記録は削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 된 경력 수준과 기록이 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gevuld carrière niveaus en records zullen worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończone poziomy kariery i rekordy zostaną usunięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os níveis de carreira e registros completos serão removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершенные уровни карьеры и записи будут удалены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เคล็ดลับการทํางานที่เสร็จสิ้นและบันทึกจะถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan kariyer seviyeleri ve kayıtları kaldırılacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершені кар'єри та записи будуть видалені."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل کیریئر سطح اور ریکارڈ ہٹا دیا جائے گا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mức độ và hồ sơ nghề nghiệp hoàn thành sẽ được xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的职业水平和记录将被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的職業水平和記錄將被刪除。"
          }
        }
      }
    },
