    "account_data_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect or recover the player account, sign out, and permanently delete the account and server data."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حماية أو استرداد حساب اللاعب، وقم بالتسجيل، وحذف باستمرار حساب وبيانات الخادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুরক্ষা বা খেলোয়াড় অ্যাকাউন্ট পুনরায়, অ্যাকাউন্ট বা সার্ভার ডেটা সীমাবদ্ধভাবে মুছে ফেলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützen oder erholen Sie das Spielerkonto, melden Sie sich aus und löschen Sie die Konto- und Serverdaten permanent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteger o recuperar la cuenta del jugador, salir y eliminar permanentemente los datos de la cuenta y el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protéger ou récupérer le compte du joueur, s’enregistrer et supprimer permanemment les données de compte et de serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खिलाड़ी खाते की रक्षा या पुनर्प्राप्त करें, बाहर साइन अप करें, और स्थायी रूप से खाते और सर्वर डेटा को हटा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melindungi atau memulihkan akun pemain, keluar, dan secara permanen menghapus akun dan data server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggere o recuperare l'account del giocatore, iscriversi e eliminare permanentemente i dati dell'account e del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイヤーのアカウントを保護または復元し、ログインを外し、アカウントおよびサーバーデータを永久に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이어 계정을 보호하거나 복구하고, 로그인하고, 계정 및 서버 데이터를 영구적으로 삭제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bescherm of herstellen van het spelaccount, uitschakelen en permanent verwijderen van de account en servergegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ochrona lub odzyskiwanie konta gracza, wyłącz się i trwale usunąć dane konta i serwera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja ou recupere a conta do jogador, saia e exclui permanentemente os dados da conta e do servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите или восстановите учетную запись игрока, выйти из учетной записи и постоянно удалить данные учетной записи и сервера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปกป้องหรือกู้คืนบัญชีผู้เล่นลงทะเบียนออกและลบข้อมูลบัญชีและเซิร์ฟเวอร์อย่างต่อเนื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyuncu hesabını koruyun veya kurtarın, oturum açın ve hesabı ve sunucu verilerini kalıcı olarak silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захистити або відновити обліковий запис гравця, вийти з і постійно видалити обліковий запис і дані сервера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کھلاڑی اکاؤنٹ کی حفاظت یا بحال کریں، باہر رجسٹر کریں، اور اکاؤنٹ اور سرور کے اعداد و شمار کو ہمیشہ ہٹا دیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảo vệ hoặc khôi phục tài khoản người chơi, đăng nhập và xóa dữ liệu tài khoản và máy chủ liên tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护或恢复玩家帐户,登录,并永久删除帐户和服务器数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護或恢復玩家帳戶,登入,並永久刪除帳戶和伺服器資料。"
          }
        }
      }
    },
