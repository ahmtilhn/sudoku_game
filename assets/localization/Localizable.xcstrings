    "matchmaking_backend_pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The online connection will use this queue when the matchmaking backend is enabled."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف تستخدم الاتصال عبر الإنترنت هذا الخصم عندما يتم تمكين خلفية التصنيف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন সংযোগ এই প্যাকেজ ব্যবহার করবে যখন matchmaking backend সক্রিয় হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Online-Verbindung wird diese Quelle verwenden, wenn die Matchmaking Backend aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión en línea utilizará esta cueva cuando se habilite el backend de la combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion en ligne utilisera cette couverture lorsque le backend de matchmaking est activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन कनेक्शन इस कवच का उपयोग करेगा जब मैच बनाने के बैकएंड को सक्षम किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi online akan menggunakan kue ini ketika backend matchmaking diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione online utilizzerà questa corda quando è abilitato il backend matchmaking."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン接続は、マッチングバックエンドが有効になったときにこのスイッチを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 연결은 matchmaking backend가 활성화되면 이 꼬리를 사용할 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De online verbinding zal deze waaier gebruiken wanneer de matchmaking backend is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie online będzie korzystać z tej cewki, gdy zostanie włączony backend matchmaking."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão on-line usará esta quebra quando o backend de matchmaking for ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн-соединение будет использовать эту ковчег, когда будет включен поддел для сбора."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อออนไลน์จะใช้สายนี้เมื่อการจัดหาการสนับสนุนการแข่งขันเปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme arka ucu etkinleştirildiğinde çevrimiçi bağlantı bu kuyruğu kullanacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн-зв'язок буде використовувати цю смугу, коли буде включено підключення до матчу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آن لائن کنکشن اس کی طرف سے استعمال کیا جائے گا جب matchmaking backend فعال ہے."
          }
        },
        "vi": {
