    "paid_coins_protection_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid Coins must be linked to a recoverable email account. Your current guest wallet and Friend ID are preserved when you protect this account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدفوعCoinيجب أن تكون مرتبطة بحساب البريد الإلكتروني قابل للاسترداد.يتم الحفاظ على محفظتك الحالية للضيوف و ID صديقك عند حماية هذا الحساب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেমেন্টCoinআপনার বর্তমান গেস্ট ফোনেট এবং বন্ধু ID সংরক্ষিত হয় যখন আপনি এই অ্যাকাউন্ট রক্ষা করা হয়."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "bezahltCoinIhre aktuelle Gastgeld und Freund-ID werden gespeichert, wenn Sie diesen Account schützen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "pagosCoinSu actual bolsillo de invitado y ID de amigo se conservan cuando usted protege esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pays payésCoinVotre portefeuille de visiteur actuel et votre ID de ami sont conservés lorsque vous protégez ce compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतानCoinआपके वर्तमान मेहमान के बटुए और मित्र आईडी को संरक्षित किया जाता है जब आप इस खाते की रक्षा करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PembayaranCoinAnda harus terhubung ke akun email yang dapat dipulihkan. dompet tamu Anda saat ini dan ID teman Anda disimpan saat Anda melindungi akun ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "pagatoCoinIl tuo attuale portafoglio ospite e ID amico sono conservati quando proteggi questo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いCoinあなたの現在のゲスト財布と友人のIDは、あなたがこのアカウントを保護するときに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지불Coin귀하의 현재 손님 지갑 및 친구 ID는 귀하가 이 계정을 보호 할 때 보존됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "betaaldCoinUw huidige gastprijs en vriend ID worden bewaard wanneer u dit account beschermt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "PłaciszCoinTwój aktualny portfel gości i identyfikator przyjaciela są zachowane, gdy chronisz ten konto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "PagamentoCoinO seu atual carteira de hóspede e ID de amigo são preservados quando você protege esta conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПлатежCoinВаш текущий гостевой портфель и ID Друзей сохраняются при защите этого счета."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การชําระเงินCoins ต้องการเชื่อมโยงกับบัญชีอีเมลที่สามารถกู้คืนได้ เงินสดของลูกค้าของคุณและ ID เพื่อนของคุณจะถูกเก็บไว้เมื่อคุณปกป้องบัญชีนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ÖdenmişCoins kurtarılabilir bir e-posta hesabına bağlanmalıdır. Bu hesabı korurken mevcut konuk cüzdanınız ve Arkadaş Kimliğiniz korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "платитиCoinВаш поточний гостьовий портфель і ідентифікатор друзів зберігаються, коли ви захищаєте цей обліковий запис."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ادائیگیCoinآپ کو ایک رجوع مکرر ای میل اکاؤنٹ سے منسلک ہونا چاہئے.آپ کے موجودہ مہمان کی پیسہ اور دوست ID اس اکاؤنٹ کی حفاظت کے وقت محفوظ ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "trả tiềnCoins phải được liên kết với tài khoản email có thể phục hồi. ví khách hiện tại và ID bạn bè của bạn được giữ lại khi bạn bảo vệ tài khoản này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款Coin您的现行客人钱包和朋友 ID 保留,当您保护该帐户时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款Coin您的現行客人錢包和朋友 ID 保留,當您保護該帳戶時。"
          }
        }
      }
    },
