        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua la tua carriera o sfida un altro giocatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャリアを継続したり、他のプレイヤーに挑戦したりします。"
