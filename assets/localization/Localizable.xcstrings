        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostałe gracze mogą znaleźć Cię na podstawie nazwy lub ID Przyjaciela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие игроки могут найти вас по имени или ID-признака."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші гравці можуть знайти вас за іменем або ідентифікатором друзів."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للاعبين الآخرين العثور عليك حسب الاسم أو ID الصديق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य खिलाड़ी आपको नाम या मित्र आईडी के माध्यम से पा सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemain lain dapat menemukan Anda dengan nama atau ID Friend."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のプレイヤーは名前または友人のIDであなたを見つけることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 플레이어는 이름 또는 친구 ID로 찾을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他玩家可以通过姓名或朋友 ID 找到您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他玩家可以透過姓名或朋友 ID 找到您。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เล่นอื่น ๆ สามารถค้นหาคุณโดยชื่อหรือ ID เพื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cầu thủ khác có thể tìm thấy bạn bằng tên hoặc ID bạn bè."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্যান্য খেলোয়াড়দের নাম বা বন্ধু ID দ্বারা আপনি খুঁজে পেতে পারেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسرے کھلاڑیوں کو آپ کے نام یا دوست ID کے ذریعے تلاش کر سکتے ہیں."
