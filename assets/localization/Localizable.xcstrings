    "online_duel_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a difficulty and match with the same queue"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار صعوبة وتوافق مع نفس الحبل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি কঠিনতা নির্বাচন করুন এবং একই চুলের সাথে সমাধান করুন"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Schwierigkeit und passen Sie mit demselben Hals"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una dificultad y se ajusta con la misma cueva"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une difficulté et correspondez avec la même coudée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक कठिनाई का चयन करें और एक ही कंगन के साथ फिट करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kesulitan dan sesuai dengan kue yang sama"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una difficoltà e corrispondi con la stessa corda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "困難を選び、同じ尾に合う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어려움을 선택하고 같은 꼬리와 일치하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een moeilijkheid en match met dezelfde kraak"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz trudność i dopasuj się do tej samej szyby"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma dificuldade e ajuste com a mesma cota"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите трудности и сопоставите с одной и той же хвосткой"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกความยากลําบากและตรงกับกระดูกเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir zorluk seçin ve aynı kuyrukla eşleştirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирайте складність і збігайтеся з однією хворобою"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک مشکل کا انتخاب کریں اور ایک ہی چمچ کے ساتھ مطابقت رکھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một khó khăn và phù hợp với cùng một con quái"
          }
        },
        "zh-Hans": {
