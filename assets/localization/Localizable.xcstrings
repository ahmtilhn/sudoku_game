    "friend_requests_setup_required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deploy the social backend and configure Firebase before using friend requests."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتنفيذ النسخة الاحتياطية الاجتماعية وتكوين Firebase قبل استخدام طلبات الأصدقاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধু অনুরোধ ব্যবহার করার আগে সামাজিক সাবসেন্ডটি ডপল করুন এবং Firebase সিস্টেমগুলি সিস্টেম করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen Sie die soziale Backend und konfigurieren Sie Firebase, bevor Sie Freundeforschungen verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desploma el backend social y configura Firebase antes de utilizar solicitudes de amigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déployez le backend social et configurez Firebase avant d’utiliser les demandes d’amis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामाजिक बैकवेन को तैनात करें और दोस्त अनुरोधों का उपयोग करने से पहले Firebase सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menginstal backend sosial dan mengkonfigurasi Firebase sebelum menggunakan permintaan teman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Implementa il backend sociale e configura Firebase prima di utilizzare richieste di amicizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソーシャルバックエンドを配置し、友人のリクエストを使用する前に Firebase を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소셜 백 앤드를 배치하고 친구 요청을 사용하기 전에 Firebase를 설정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats de sociale backend en configurer Firebase voordat je vriendenspraak gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmieszcz społeczność i skonfigurować Firebase przed użyciem zapytania przyjaciół."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue o backend social e configure Firebase antes de usar pedidos de amigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Развертайте социальную подгрузку и настройте Firebase перед использованием запросов друзей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัจจุบันการสนับสนุนทางสังคมและกําหนด Firebase ก่อนที่จะใช้คําขอเพื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sosyal arka ucu dağıtın ve arkadaş isteklerini kullanmadan önce Firebase'i yapılandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розподіть соціальний підхід і налаштуйте Firebase перед використанням запитів друзів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوستوں کے درخواستوں کا استعمال کرنے سے پہلے سوشل بیس کو ڈپازٹ کریں اور فائر بیس کو ترتیب دیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo nền tảng xã hội và cấu hình Firebase trước khi sử dụng yêu cầu bạn bè."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部署社交备份,并在使用朋友请求之前设置 Firebase。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部署社交備份,並在使用朋友請求之前設定 Firebase。"
          }
        }
      }
    },
