          "stringUnit": {
            "state": "translated",
            "value": "เลือกความยากลําบากและได้รับความกลัวใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir zorluk seçin ve yeni bir bulmaca edinin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть складність і отримати новий пuzzle"
          }
