    "connect_platform_profile_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدامPlay GamesأوGame Centerلأصدقاء الأصليين، ورؤساء، والإنجازات، وملفات اللاعبين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যবহারPlay GamesঅথবাGame Centerস্বীয় বন্ধু, নেতৃত্ববর্গ, অর্জন এবং খেলোয়াড় প্রোফাইলের জন্য।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GebrauchPlay GamesoderGame Centerfür indische Freunde, Führungskräfte, Errungenschaften und Spielerprofile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Play Games or Game Center for native friends, leaderboards, achievements, and player profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UsoPlay GamesoGame Centerpara amigos nativos, tablas de liderazgo, logros y perfiles de jugador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UtiliserPlay GamesouGame Centerpour les amis autochtones, les tables de leadership, les réalisations et les profils de joueurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग करेंPlay GamesयाGame Centerमूल मित्रों, लीडरबोर्ड, उपलब्धियों और खिलाड़ी प्रोफाइल के लिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PenggunaanPlay GamesatauGame Centeruntuk teman asli, papan pemimpin, pencapaian, dan profil pemain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UtilizzoPlay GamesoGame Centerper amici nativi, leader, risultati e profili di giocatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用Play GamesあるいはGame Center親友、リーダーボード、成果、プレイヤーのプロファイルのために。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하기Play Games또는Game Center원주민 친구, 리더십, 성과 및 플레이어 프로필을 위해."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GebruikPlay GamesofGame Centervoor inheemse vrienden, leiderschap, prestaties en spelersprofielen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UżywaniePlay GameslubGame Centerdla przyjaciół, liderów, osiągnięć i profili graczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "UsandoPlay GamesouGame Centerpara amigos nativos, painéis de liderança, realizações e perfis de jogador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИспользованиеPlay GamesилиGame Centerдля родных друзей, лидерских таблиц, достижений и профилей игроков."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้Play GamesหรือGame Centerสําหรับเพื่อนชาวบ้านคณะกรรมการผู้นําการสําเร็จและโปรไฟล์ผู้เล่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "KullanPlay GamesveyaGame CenterYerli arkadaşlar, lider tahtaları, başarılar ve oyuncu profilleri için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ВикористанняPlay GamesабоGame Centerдля корінних друзів, лідерських панелей, досягнень і профілів гравців."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "استعمال کریںPlay GamesیاGame Centerانٹرویو کے لئے دوستوں، رہنماؤں، کامیابیوں، اور کھلاڑی پروفائل."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụngPlay GameshoặcGame Centercho bạn bè bản địa, bảng xếp hạng, thành tựu và hồ sơ người chơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用Play Games或Game Center对于本地朋友、领袖板、成就和玩家资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用Play Games或Game Center對於本地朋友、領袖板、成就和玩家資料。"
          }
        }
      }
    },
    "connected_player": {
      "localizations": {
        "ar": {
