    "career_random_intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a difficulty. A fresh, unique Sudoku will be generated for every game."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يتم إنشاء سودوكو طازجة وفريدة من نوعها لكل لعبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ফ্রিজ, একটি অনন্য সুডোকু প্রতিটি খেলা জন্য তৈরি হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frische, einzigartige Sudoku wird für jedes Spiel generiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Sudoku fresco y único se generará para cada juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Sudoku frais et unique sera généré pour chaque jeu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ताजा, अद्वितीय सुडोकू प्रत्येक खेल के लिए बनाया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudoku segar dan unik akan dihasilkan untuk setiap permainan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Sudoku fresco e unico sarà generato per ogni gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのゲームに新鮮でユニークなスドーコが生成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 게임에 대해 신선하고 독특한 Sudoku가 생성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verse, unieke Sudoku zal worden gegenereerd voor elk spel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do każdego gry zostanie stworzony świeży, wyjątkowy Sudoku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Sudoku fresco e único será gerado para cada jogo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте трудности. для каждой игры будет создано свежее, уникальное Судоку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกความยากลําบาก ใหม่และเอกลักษณ์ของซูโดคจะถูกสร้างขึ้นสําหรับทุกเกม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir zorluk seçin. Her oyun için taze, benzersiz bir Sudoku üretilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свіжий, унікальний Судоку буде створений для кожної гри."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک تازہ، منفرد Sudoku ہر کھیل کے لئے پیدا کیا جائے گا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một Sudoku tươi, độc đáo sẽ được tạo ra cho mỗi trò chơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个困难,每场比赛都会产生新鲜而独特的苏多库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個困難,每場比賽都會產生新鮮而獨特的蘇多庫。"
          }
        }
      }
    },
    "three_mistake_rule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Career rule: the round ends after 3 wrong moves."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة المهنة: ينتهي الجولة بعد 3 حركات خاطئة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যারিয়ার নিয়ম: তিনটি ভুল হ্রাসের পর রুট শেষ হয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karriereregel: Der Runde endet nach 3 falschen Bewegungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regla de carrera: el ronda termina después de 3 movimientos equivocados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle de carrière : le tour se termine après 3 mouvements erronés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैरियर नियम: तीन गलत आंदोलनों के बाद दौर समाप्त होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peraturan karir: putaran berakhir setelah 3 gerakan yang salah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola di carriera: il round finisce dopo 3 movimenti sbagliati."
          }
        },
        "ja": {
