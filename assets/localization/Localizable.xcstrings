    "profile_discovery_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other players can find you by name or Friend ID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer oyuncular sizi isim veya Arkadaş Kimliği ile bulabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Spieler können Sie nach Namen oder Freund-ID finden."
          }
