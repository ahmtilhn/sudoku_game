    "daily_reward_track_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعال غداً لتستمر في مسيرتك لمدة 30 يوماً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগামীকাল ফিরে আসুন এবং আপনার ৩০ দিনের ট্র্যাকে চলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommen Sie morgen zurück und fortsetzen Sie Ihre 30-Tage-Track."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back tomorrow to continue your 30-day track."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regresar mañana para seguir tu trayectoria de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendez-vous demain pour continuer votre trajet de 30 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल वापस आओ और अपने 30 दिन के ट्रैक को जारी रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali esok untuk melanjutkan perjalanan 30 hari Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritorna domani per continuare il tuo percorso di 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日、30日間のトラックを続けるために戻って来てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 다시 와서 30일 트랙을 계속하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom morgen terug om je 30 dagen traject te volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyjdź jutro i kontynuuj swoją 30-dniową ścieżkę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte amanhã para continuar o seu caminho de 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завтра вы возвращаетесь, чтобы продолжить свой 30-дневный путь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มากลับในวันพรุ่งนี้เพื่อดําเนินการตามเส้นทางของคุณ 30 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarın 30 günlük rotana devam etmek için geri dön."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завтра поверніться, щоб продовжити свій 30-денний шлях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کو 30 دن کے راستے پر واپس آنے کے لئے واپس آنا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy trở lại ngày mai để tiếp tục con đường 30 ngày của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天回来,继续你的30天轨道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明天回來,繼續你的30天軌道。"
          }
        }
