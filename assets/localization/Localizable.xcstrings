    "online_challenge_notifications_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows friend and challenge invitations on this device. You can turn this off at any time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض الأصدقاء وتحدي الدعوات على هذا الجهاز.يمكنك إيقاف تشغيل هذا في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে বন্ধু এবং ডিভাইসের ডিভাইস দেখুন. আপনি এই ডিভাইসটি কোন সময় বন্ধ করতে পারেন."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie Freunde und Herausforderung Einladungen auf diesem Gerät. Sie können dies jederzeit aussteigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar amigos y desafíos invitaciones en este dispositivo. Puedes desactivar esto en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher des invitations et des invitations sur ce appareil. Vous pouvez l'ouvrir à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर दोस्त दिखाएं और आमंत्रणों को चुनौती दें. आप इसे किसी भी समय बंद कर सकते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan teman dan mencabar jemputan pada perangkat ini. Anda dapat mematikan ini kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra amici e sfida inviti su questo dispositivo. puoi disattivare questo in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで友人と挑戦の招待状を表示します. いつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에서 친구를 표시하고 초대장을 도전합니다.이 장치를 언제든지 끄는 방법."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie vrienden en uitdagingen op deze apparaat. u kunt dit op elk moment uitzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla przyjaciół i wyzwanie zaproszeń na tym urządzeniu. można wyłączyć w dowolnym momencie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre amigos e desafia convites neste dispositivo. Você pode desligar isso a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите друзей и вызовите приглашения на этом устройстве. Вы можете отключить это в любое время."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเพื่อนและท้าทายคําแนะนําบนอุปกรณ์นี้ คุณสามารถเปิดใช้งานได้ตลอดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda arkadaş ve meydan okuma davetlerini gösterir. Bunu istediğiniz zaman kapatabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показати друзів і викликати запрошення на цьому пристрої. Ви можете відключити це в будь-який час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلہ پر دوستوں کو دکھائیں اور دعوتوں کو چیلنج کریں۔ آپ اس کو کسی بھی وقت بند کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị bạn bè và thử thách lời mời trên thiết bị này. bạn có thể tắt nó bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示朋友和挑战邀请在这个设备上. 您可以随时关闭此。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示朋友和挑戰邀請在這個裝置上. 您可以隨時關閉此。"
          }
        }
      }
    },
    "online_challenge_notifications_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Challenge notifications require Firebase and the social backend to be configured."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب إشعارات التحدي إعداد Firebase و social backend."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চ্যালেঞ্জ বিজ্ঞাপনগুলি Firebase এবং সামাজিক সাবসেন্স সংগঠিত করতে হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herausforderungskommunikation erfordert Firebase und die soziale Backend zu konfigurieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de desafío requieren que Firebase y el backend social sean configurados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de défi nécessitent que Firebase et le support social soient configurés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनौती सूचनाओं को Firebase और सामाजिक बैकअप को कॉन्फ़िगर करने की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi tantangan memerlukan Firebase dan backend sosial untuk dikonfigurasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di sfida richiedono che Firebase e il backend sociale siano configurati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "挑戦通知には、Firebaseとソーシャルバックエンドが構成される必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도전 알림은 Firebase와 사회적 지원을 구성해야합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitdaging meldingen vereisen dat Firebase en de sociale backend worden geconfigureerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikacje wyzwania wymagają konfiguracji Firebase i wsparcia społecznego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificações de desafio requer que Firebase e o backend social sejam configurados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Послания на вызов требуют конфигурирования Firebase и социальной подсчёта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความท้าทายต้องกําหนด Firebase และ backend สังคม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meydan okuma bildirimleri Firebase ve sosyal arka ucun yapılandırılmasını gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення про виклик вимагають, щоб Firebase і соціальний підхід були конфігуровані."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چیلنج نوٹس کو فائر بیس اور سوشل سپیکنڈ کو ترتیب دینے کی ضرورت ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thông báo thách thức yêu cầu Firebase và nền tảng xã hội phải được cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑战通知需要 Firebase 和社交支持设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挑戰通知需要 Firebase 和社交支援設定。"
          }
        }
      }
    },
    "challenge_notification_permission_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission was not granted. Online challenge notifications remain off."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم منح إذن الإشعار.تظل إشعارات التحدي عبر الإنترنت مفتوحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন চ্যালেঞ্জ বিজ্ঞাপন বন্ধ থাকবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifizierungsverleih wurde nicht erteilt. Online-Challenge-Nachrichten bleiben nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha concedido permiso de notificación. las notificaciones de desafío en línea permanecen apagadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune notification n’a été accordée. les notifications de défi en ligne sont désactivées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना अनुमति नहीं दी गई. ऑनलाइन चुनौती सूचनाएं बंद रहती हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada izin pemberitahuan yang diberikan. pemberitahuan tantangan online tetap dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato concesso il permesso di notifica. le notifiche di sfida online rimangono aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知許可は与えられていません. オンラインの挑戦通知は終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통보 허가가 부여되지 않았습니다.온라인 도전 통보는 여전히 열려 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificatievergunning is niet verleend. online challenge-notificaties blijven af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udzielono zezwolenia na powiadomienie. powiadomienia o wyzwaniach online pozostają nieobecne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi concedida a permissão de notificação. notificações de desafio online permanecem apagadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяние на уведомление не было предоставлено. онлайн-задачи о вызове остаются закрытыми."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนไม่ได้รับอนุญาต การแจ้งเตือนการท้าทายออนไลน์ยังคงปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni verilmedi. Çevrimiçi meydan okuma bildirimleri kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення про виклик не було видано. онлайн-виклики повідомлень залишаються недійсними."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹس کی اجازت نہیں دی گئی۔ آن لائن چیلنج نوٹس بند رہیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không được cấp phép thông báo. thông báo thách thức trực tuyến vẫn bị tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经授予通知许可,在线挑战通知仍在关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未經授予通知許可,線上挑戰通知仍在關閉。"
          }
        }
      }
    },
