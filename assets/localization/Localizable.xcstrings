    "coin_required_body": {
      "comment": "Online duel UI text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each player contributes 100 Coin. The winner receives the 200 Coin pot."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل لاعب يقدم 100Coinالفائز يحصل على 200Coinبوت"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি খেলোয়াড় ১০০Coinবিজয়ীকে ২০০টি জিততে হবে।Coinপট"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Spieler trägt 100CoinDer Gewinner erhält die 200CoinPotenzial"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada jugador contribuye a 100CoinEl ganador recibe los 200CoinEl Pot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque joueur apporte 100CoinLe gagnant reçoit les 200CoinLe pot."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक खिलाड़ी 100 में योगदान देता हैCoinविजेता को 200 मिल जाएंगे।Coinपॉट"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pemain menyumbang 100CoinPemenang akan menerima 200CoinPot yang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giocatore contribuisce 100CoinIl vincitore riceve i 200CoinIl pot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プレイヤーは100Coin優勝者は200を獲得する。Coinポット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 플레이어는 100Coin우승자는 200을 받는다.Coin포트"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke speler krijgt 100CoinDe winnaar krijgt de 200CoinDe pot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy gracz wkracza 100CoinZwycięzca otrzymuje 200 złCoinPotem to."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada jogador contribui 100CoinO vencedor recebe os 200CoinPô de Pô."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый игрок вносит 100CoinПобедитель получает 200CoinПот →"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เล่นแต่ละรายมีส่วนร่วม 100Coinผู้ชนะได้รับ 200Coinพาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her oyuncu 100 katkı sağlarCoin. Kazanan 200'ü alırCoinTencere."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен гравець отримує 100CoinПереможець отримає 200CoinПот"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر کھلاڑی 100 روپے کا حصہ بنتا ہےCoinجیتنے والے کو 200 ملین ملے گیCoinپاؤڈر"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi cầu thủ đóng góp 100CoinNgười chiến thắng sẽ nhận được 200CoinPot của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每位玩家都捐款100Coin获胜者获200Coin波特"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每位玩家都捐款100Coin獲勝者獲200Coin波特"
          }
        }
      }
    },
