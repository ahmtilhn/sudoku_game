    "sign_out_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى المحفظة المحمية على الحساب، وسوف يستخدم هذا الجهاز ضيفًا حتى تقوم بالتسجيل مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুরক্ষিত বাক্সটি অ্যাকাউন্টে থাকবে. এই ডিভাইসটি আবারও প্রবেশ করার পর্যন্ত একটি গেস্ট ব্যবহার করবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geschützte Portfolio bleibt auf dem Konto. Dieses Gerät wird einen Gast benutzen, bis Sie sich erneut anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The protected wallet stays on the account. This device will use a guest until you sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bolsa protegida permanece en la cuenta.Este dispositivo utilizará a un invitado hasta que se inscriba de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La portefeuille protégée reste sur le compte.Cette appareil utilise un hôte jusqu'à ce que vous vous inscriviez à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संरक्षित बटुआ खाते में रहता है. इस डिवाइस में आप फिर से साइन इन करने तक एक मेहमान का उपयोग करेंगे."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet yang dilindungi tetap di akun. perangkat ini akan menggunakan tamu sampai Anda mendaftar kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio protettivo rimane sul conto.Questo dispositivo utilizzerà un ospite fino a quando non si iscrive di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護された財布はアカウントに残ります このデバイスは、再びサインインするまでゲストを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호된 지갑은 계정에 남아 있습니다.이 장치는 다시 로그인 할 때까지 손님을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beveiligde portemonnee blijft op het account. Dit apparaat gebruikt een gast totdat u zich opnieuw registreert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisy chronione pozostają na koncie.Ten urządzenie będzie korzystać z gościa, aż ponownie się zalogujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O bolso protegido permanece na conta. Este dispositivo usará um convidado até que você se inscreva novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищенный кошелек остается на счету.Это устройство будет использовать гостя до того, как вы снова зарегистрируетесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าถือที่ปกป้องจะอยู่บนบัญชี อุปกรณ์นี้จะใช้ผู้เข้าพักจนกว่าคุณลงทะเบียนอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korumalı cüzdan hesapta kalır. Bu cihaz siz tekrar oturum açana kadar bir konuk kullanacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Захищений кошелек залишається на рахунку.Це пристрій буде використовувати гостя, поки ви не зареєструєтесь знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ پیسہ اکاؤنٹ پر رہتا ہے یہ آلہ ایک مہمان کا استعمال کرے گا جب تک آپ دوبارہ لاگ ان نہیں کریں گے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiền mặt được bảo vệ vẫn còn trên tài khoản. thiết bị này sẽ sử dụng khách cho đến khi bạn đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护的钱包留在帐户上,该设备将使用客人,直到您再次登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護的錢包留在帳戶上,該裝置將使用客人,直到您再次登入。"
          }
        }
      }
    },
