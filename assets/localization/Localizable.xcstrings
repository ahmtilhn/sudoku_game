    "daily_sudoku_challenges_channel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير يومي للعودة إلى تحدي سودوكو الطازج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিনের স্মৃতিগুলি একটি নতুন সুডোকু চ্যালেঞ্জের জন্য ফিরে আসতে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagliche Erinnerungen, um zurück zu einem frischen Sudoku-Ausdeckung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily reminders to return for a fresh Sudoku challenge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los días recordos para volver para un nuevo reto Sudoku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les souvenirs quotidiens pour revenir pour un nouveau défi Sudoku."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ताजा सुडोक चुनौती के लिए वापस लौटने के लिए दैनिक यादें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari-hari mengingatkan untuk kembali untuk tantangan Sudoku segar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno ricorda di tornare per un nuovo Sudoku Challenge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日、新鮮なスドーコの挑戦に戻ることを思い出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 추억은 신선한 Sudoku 도전을 위해 돌아갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijks herinneringen om terug te keren voor een verse Sudoku uitdaging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codzienne przypomnienia o powrocie na świeże Sudoku wyzwanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dias lembranças para voltar para um novo desafio Sudoku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневные воспоминания о возвращении к свежему вызову Судоку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกวันเตือนที่จะกลับมาสําหรับท้าทายซูโดคิวสด"
