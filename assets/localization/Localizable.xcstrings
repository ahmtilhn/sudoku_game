    "same_difficulty_match": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will only be matched with players who selected the same difficulty."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف تتطابق فقط مع اللاعبين الذين اختاروا نفس الصعوبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি শুধু একই কঠিনতা নির্বাচন করা খেলোয়াড়দের সাথে সমাধান করা হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden nur mit den Spielern, die die gleiche Schwierigkeit ausgewählt werden, vereinbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se ajustará con los jugadores que seleccionaron la misma dificultad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne serez compatibles que avec les joueurs qui ont choisi la même difficulté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप केवल उन खिलाड़ियों के साथ मेल खाएंगे जिन्होंने एक ही कठिनाई का चयन किया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda hanya akan disesuaikan dengan pemain yang memilih kesulitan yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarai solo in grado di corrispondere con i giocatori che hanno scelto la stessa difficoltà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ困難を選んだ選手と合うだけになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 같은 어려움을 선택한 플레이어와 만 맞게 될 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U wordt alleen geïntroduceerd met spelers die dezelfde moeilijkheid hebben geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Będziesz tylko dopasowany do graczy, którzy wybrali tę samą trudność."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você só será matched com jogadores que selecionaram a mesma dificuldade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы будете совпадать только с игроками, которые выбрали ту же трудность."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะตรงกับผู้เล่นที่เลือกความยากลําบากเดียวกันเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece aynı zorluğu seçen oyuncularla eşleşeceksiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви будете відповідати тільки гравцям, які вибрали таку ж труднощі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کو صرف وہ کھلاڑیوں کے ساتھ مطابقت حاصل کی جائے گی جو اسی مشکل کو منتخب کرتے ہیں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ chỉ được phù hợp với những người chơi đã chọn cùng một khó khăn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您只会与选择相同困难的玩家匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您只會與選擇相同困難的玩家匹配。"
          }
        }
      }
    },
