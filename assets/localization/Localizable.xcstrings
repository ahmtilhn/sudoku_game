    "welcome_new_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn the rules with a quick tutorial, then start your career."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعلم القواعد باستخدام دليل سريع ، ثم ابدأ حياتك المهنية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি দ্রুত টুইটরির সাথে নিয়মগুলি শিখুন, তারপর আপনার ক্যারিয়ার শুরু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lernen Sie die Regeln mit einem schnellen Tutorial und beginnen Sie dann Ihre Karriere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenda las reglas con un tutorial rápido, luego comienza su carrera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez les règles avec un tutoriel rapide, puis commencez votre carrière."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक त्वरित ट्यूटोरियल के साथ नियमों को सीखें, फिर अपनी कैरियर शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelajari aturan dengan tutorial cepat, kemudian memulai karir Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imparare le regole con un tutorial veloce, poi iniziare la tua carriera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを迅速なトリックで学び、その後キャリアを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 튜토리얼을 사용하여 규칙을 배우고 경력을 시작하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer de regels met een snelle tutorial, en begin dan je carrière."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naucz się zasad za pomocą szybkiego tutorial, a następnie rozpocznij swoją karierę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenda as regras com um tutorial rápido, e então comece a sua carreira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте правила с помощью быстрой инструкции, а затем начните свою карьеру."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียนรู้กฎด้วยคู่มืออย่างรวดเร็วแล้วเริ่มอาชีพของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı bir öğretici ile kuralları öğrenin, ardından kariyerinize başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчайте правила швидким туториалом, а потім розпочнете свою кар'єру."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک تیزی سے ٹیوٹوریل کے ساتھ قواعد سیکھیں، پھر آپ کی کیریئر شروع کریں."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm hiểu các quy tắc với một hướng dẫn nhanh chóng, sau đó bắt đầu sự nghiệp của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过快速的教程学习规则,然后开始你的职业生涯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過快速的教程學習規則,然後開始你的職業生涯。"
          }
        }
      }
    },
    "career_intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with the easiest puzzles and progress step by step."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بأسهل الألغاز والتقدم خطوة بخطوة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে সহজ পুজো দিয়ে শুরু করুন এবং ধাপ-পক্ষে প্রদর্শন করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit den einfachsten Rätsel und Fortschritte Schritt für Schritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzar con los puzzles más fáciles y avanzar paso a paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par les puzzles les plus faciles et progressez pas à pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे आसान पहेली के साथ शुरू करें और कदम-दर-चरण प्रगति करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan teka-teki yang paling mudah dan kemajuan langkah demi langkah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con i puzzle più semplici e progressi passo dopo passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も簡単なパズルと進歩をステップからステップで始める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 쉬운 퍼즐과 단계별로 진행하기 시작합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met de makkelijkste puzzels en stap voor stap vooruitgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od najprostszych zagadków i postęp krok po kroku."
          }
        },
        "pt": {
          "stringUnit": {
