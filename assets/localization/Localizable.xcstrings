    "create_player_profile_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your display name is shown in matches. Your unique username can be searched, while your permanent Friend ID never changes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن البحث عن اسم المستخدم الفريد الخاص بك، في حين أن ID صديقك الدائم لا يتغير أبدا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার একক ব্যবহারকারীর নাম খুঁজে পেতে পারেন, যখন আপনার স্থায়ী বন্ধু ID কখনও পরিবর্তন হয় না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr einzigartiges Benutzername kann gesucht werden, während Ihr dauerhafter Freund-ID nie ändert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su nombre de pantalla se muestra en matices. su nombre de usuario único se puede buscar, mientras que su ID de amigo permanente nunca cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom d'utilisateur unique peut être recherché, tandis que votre ID de ami permanent ne change jamais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका विशिष्ट उपयोगकर्ता नाम खोजा जा सकता है, जबकि आपका स्थायी मित्र आईडी कभी नहीं बदलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama pengguna unik Anda dapat dicari, sementara ID Friend permanen Anda tidak pernah berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome utente unico può essere ricercato, mentre il tuo ID amico permanente non cambia mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのユニークなユーザー名は検索できますが、永久友人のIDは決して変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 독특한 사용자 이름은 검색될 수 있으며 영구적 인 친구 ID는 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw unieke gebruikersnaam kan worden gezocht, terwijl uw permanente Vriend ID nooit verandert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje unikalne nazwisko użytkownika można wyszukiwać, podczas gdy Twoje stałe ID Przyjaciela nigdy się nie zmienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome de usuário único pode ser procurado, enquanto seu ID de amigo permanente nunca muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше уникальное имя пользователя можно искать, а постоянный идентификатор Дружника никогда не меняется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อหน้าจอของคุณจะแสดงในคู่ของคุณ ชื่อผู้ใช้ที่ไม่ซ้ํากันของคุณสามารถค้นหาได้ในขณะที่ ID เพื่อนที่อยู่เสมอของคุณไม่เปลี่ยนแปลงได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran adınız eşleşmelerde gösterilir. Benzersiz kullanıcı adınız aranabilirken, kalıcı Arkadaş Kimliğiniz asla değişmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші унікальні імена користувачів можна шукати, а ваш постійний ідентифікатор друзів ніколи не змінюється."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا منفرد صارف کا نام تلاش کیا جا سکتا ہے، جبکہ آپ کا دائمی دوست ID کبھی نہیں بدلتا."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên hiển thị của bạn được hiển thị trong các trận đấu. tên người dùng độc đáo của bạn có thể được tìm kiếm, trong khi ID bạn bè vĩnh viễn của bạn không bao giờ thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的单一用户名可以搜索,而您的永久友人 ID 永远不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的單一使用者名稱可以搜尋,而您的永久友人 ID 永遠不會改變。"
          }
        }
      }
    },
