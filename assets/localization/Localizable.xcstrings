    "analytics_sharing_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows anonymous usage analytics to help improve Sudoku Duel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح بتحليلات الاستخدام المجهولة للمساعدة في تحسينSudoku Duel."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উন্নতিতে সহায়তা করার জন্য অ্যানোনাম ব্যবহার বিশ্লেষণ অনুমতিSudoku Duel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt anonymes Benutzungsanalytikum, um zu verbessernSudoku Duel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite análisis de uso anónimo para ayudar a mejorarSudoku Duel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet des analyses d’utilisation anonymes pour améliorerSudoku Duel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेहतर बनाने में मदद करने के लिए अनाम उपयोग विश्लेषण की अनुमति देता हैSudoku Duel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan anonim analisis penggunaan untuk membantu meningkatkanSudoku Duel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette analisi di utilizzo anonime per migliorareSudoku Duel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名の使用分析を可能にし、改善を支援するSudoku Duel."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개선을 위한 익명의 사용 분석을 허용Sudoku Duel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonieme gebruiksanalyses helpen bij het verbeterenSudoku Duel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala na anonimowe analizy użytkowania, aby pomóc poprawićSudoku Duel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite anônimas análises de uso para ajudar a melhorarSudoku Duel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешается анонимный анализ использования, чтобы помочь улучшитьSudoku Duel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยให้การวิเคราะห์การใช้งานที่匿名เพื่อช่วยปรับปรุงSudoku Duel."
