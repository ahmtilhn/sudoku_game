        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ chỉ được phù hợp với cùng một loại trò chơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您只會與同一類型的遊戲相匹配。"
          }
