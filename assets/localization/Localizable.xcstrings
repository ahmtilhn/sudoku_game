    "waiting_for_ranked_opponent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are in the ranked queue. The app checks for a match every few seconds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranked kuyruğundasın. Uygulama birkaç saniyede bir eşleşme kontrol eder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist in der Ranglisten-Warteschlange. Die App prüft alle paar Sekunden auf ein Match."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes dans la file classée. L’app vérifie une partie toutes les quelques secondes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás en la cola clasificatoria. La app busca partida cada pocos segundos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está na fila ranqueada. O app verifica uma partida a cada poucos segundos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei nella coda classificata. L’app controlla una partita ogni pochi secondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je staat in de ranked wachtrij. De app controleert elke paar seconden op een match."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś w kolejce rankingowej. Aplikacja co kilka sekund sprawdza dopasowanie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы в рейтинговой очереди. Приложение проверяет матч каждые несколько секунд."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви в рейтинговій черзі. Застосунок перевіряє матч кожні кілька секунд."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت في قائمة الانتظار المصنفة. يتحقق التطبيق من وجود مباراة كل بضع ثوان."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप रैंक्ड कतार में हैं। ऐप हर कुछ सेकंड में मैच जांचता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda berada di antrean peringkat. Aplikasi memeriksa pertandingan setiap beberapa detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランク戦の待機列にいます。数秒ごとに対戦を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "랭크 대기열에 있습니다. 앱이 몇 초마다 매치를 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已进入排位队列。应用每隔几秒检查一次匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已進入排名佇列。應用程式每隔幾秒檢查一次配對。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยู่ในคิวจัดอันดับ แอปจะตรวจหาคู่แข่งทุกไม่กี่วินาที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ở hàng chờ xếp hạng. Ứng dụng kiểm tra trận sau vài giây."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি র‍্যাঙ্কড সারিতে আছেন। অ্যাপ কয়েক সেকেন্ড পরপর ম্যাচ খোঁজে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ رینکڈ قطار میں ہیں۔ ایپ ہر چند سیکنڈ بعد میچ چیک کرتی ہے۔"
          }
        }
      }
    },
