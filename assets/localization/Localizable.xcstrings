        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le bâtiment installé, la session Firebase et le serveur social."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थापित निर्माण, Firebase सत्र और सामाजिक सर्वर की जांच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa instalasi, sesi Firebase dan server sosial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la configurazione installata, la sessione Firebase e il server sociale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールされた構築、Firebase セッション、ソーシャル サーバーをチェックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 건물, Firebase 세션 및 소셜 서버를 확인합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de geïnstalleerde build, Firebase-sessie en sociale server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź zainstalowany budynek, sesję Firebase i serwer społecznościowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a configuração instalada, a sessão Firebase e o servidor social."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте установленный строй, сессию Firebase и социальный сервер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบการสร้างที่ติดตั้งเซสชัน Firebase และเซิร์ฟเวอร์สังคม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü yapı, Firebase oturumu ve sosyal sunucuyu kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте встановлений будинок, сесію Firebase та соціальний сервер."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انسٹال کردہ عمارت، فائر بیس سیشن اور سوشل سرور پر چیک کریں."
          }
        },
        "vi": {
          "stringUnit": {
